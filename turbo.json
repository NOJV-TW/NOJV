{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env",
    ".env.example",
    ".nvmrc",
    "eslint.config.mjs",
    "pnpm-workspace.yaml",
    "scripts/prepare-wasm-oj-assets.mjs",
    "tooling/eslint/base.mjs",
    "tooling/typescript/base.json",
    "tsconfig.base.json",
    "tsdown.base.mjs"
  ],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "paraglide:compile"],
      "outputs": [
        "dist/**",
        ".svelte-kit/**",
        "build/**",
        "generated/**",
        "static/wasm-oj/**",
        "static/_app/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "paraglide:compile"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["paraglide:compile"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "paraglide:compile"],
      "outputs": []
    },
    "paraglide:compile": {
      "inputs": ["project.inlang/**", "messages/**"],
      "outputs": ["src/lib/paraglide/**"]
    },
    "db:generate": {
      "outputs": ["generated/**"]
    }
  }
}
